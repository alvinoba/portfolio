---
// ContactTerminal.astro - Terminal-Style Contact Form
---

<section id="contact" class="w-full px-4 sm:px-6 lg:px-8 py-20 sm:py-32 relative overflow-hidden" onclick="document.getElementById('contact').scrollIntoView({ behavior: 'smooth' })">
	<!-- Section Header -->
	<div class="max-w-2xl mx-auto mb-12 sm:mb-16">
		<div class="flex items-center gap-3 mb-4">
			<div class="w-3 h-3 rounded-full bg-neon-purple animate-pulse" style="box-shadow: 0 0 10px rgba(157, 78, 221, 0.8);"></div>
			<span class="font-mono text-xs sm:text-sm text-neon-purple tracking-wider">COMMUNICATION PROTOCOL</span>
		</div>

		<div class="mb-8">
			<h2 class="text-4xl sm:text-5xl lg:text-6xl font-mono font-bold mb-4">
				<span class="text-neon-purple">[ </span>
				<span class="text-white">INITIATE CONTACT</span>
				<span class="text-neon-purple"> ]</span>
			</h2>
			<div class="h-px w-32 sm:w-48 bg-gradient-to-r from-neon-purple to-transparent"></div>
		</div>

		<p class="text-gray-300 text-base sm:text-lg">
			Send me a message and I'll respond as soon as possible. Available for opportunities, collaborations, and inquiries.
		</p>
	</div>

	<!-- Contact Container -->
	<div class="max-w-2xl mx-auto">
		<div class="rounded-lg border border-neon-purple/30 bg-cyber-black/40 backdrop-blur-md overflow-hidden shadow-[0_0_40px_rgba(157,78,221,0.2)] group hover:border-neon-purple/60 hover:shadow-[0_0_50px_rgba(157,78,221,0.4)] transition-all duration-300">
			<!-- Terminal Header -->
			<div class="px-4 sm:px-6 py-4 border-b border-neon-purple/20 bg-gradient-to-r from-neon-purple/10 to-transparent">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-2">
						<div class="w-3 h-3 rounded-full bg-red-500"></div>
						<div class="w-3 h-3 rounded-full bg-yellow-500"></div>
						<div class="w-3 h-3 rounded-full bg-green-500"></div>
					</div>
					<div class="text-xs sm:text-sm font-mono text-neon-purple">contact_terminal.exec</div>
					<div class="w-3 h-3"></div>
				</div>
			</div>

			<!-- Terminal Content -->
			<div class="px-4 sm:px-8 py-8">
				<!-- Terminal Line 1 -->
				<div class="mb-6 font-mono text-xs sm:text-sm text-gray-400">
					<span class="text-neon-purple">$</span> <span class="text-white">initialize_contact_form</span>
				</div>

				<!-- Form -->
				<form id="contact" class="space-y-6" action="https://formspree.io/f/xwlkyodz" method="POST" >
					<!-- Name Input -->
					<div class="space-y-2">
						<label class="block font-mono text-sm text-neon-purple">
							<span class="text-gray-400">~/input/</span>name*
						</label>
						<input 
							type="text"
							name="name"
							placeholder="Enter your full name"
							required
							class="w-full px-4 py-3 rounded-lg bg-cyber-black border border-neon-purple/30 text-white font-mono text-sm placeholder-gray-600 focus:outline-none focus:border-neon-purple/80 focus:shadow-[0_0_10px_rgba(157,78,221,0.3)] transition-all duration-300"
						/>
					</div>

					<!-- Email Input -->
					<div class="space-y-2">
						<label class="block font-mono text-sm text-neon-purple">
							<span class="text-gray-400">~/input/</span>email*
						</label>
						<input 
							type="email"
							name="email"
							placeholder="your.email@example.com"
							required
							class="w-full px-4 py-3 rounded-lg bg-cyber-black border border-neon-purple/30 text-white font-mono text-sm placeholder-gray-600 focus:outline-none focus:border-neon-purple/80 focus:shadow-[0_0_10px_rgba(157,78,221,0.3)] transition-all duration-300"
						/>
					</div>

					<!-- Subject Input -->
					<div class="space-y-2">
						<label class="block font-mono text-sm text-neon-purple">
							<span class="text-gray-400">~/input/</span>subject*
						</label>
						<input 
							type="text"
							name="subject"
							placeholder="Project inquiry, collaboration, etc."
							required
							class="w-full px-4 py-3 rounded-lg bg-cyber-black border border-neon-purple/30 text-white font-mono text-sm placeholder-gray-600 focus:outline-none focus:border-neon-purple/80 focus:shadow-[0_0_10px_rgba(157,78,221,0.3)] transition-all duration-300"
						/>
					</div>

					<!-- Message Textarea -->
					<div class="space-y-2">
						<label class="block font-mono text-sm text-neon-purple">
							<span class="text-gray-400">~/input/</span>message*
						</label>
						<textarea 
							name="message"
							placeholder="Share your message here... (minimum 10 characters)"
							required
							rows={6}
							class="w-full px-4 py-3 rounded-lg bg-cyber-black border border-neon-purple/30 text-white font-mono text-sm placeholder-gray-600 focus:outline-none focus:border-neon-purple/80 focus:shadow-[0_0_10px_rgba(157,78,221,0.3)] transition-all duration-300 resize-none"
						></textarea>
					</div>

					<!-- Privacy Notice -->
					<div class="p-3 rounded-lg bg-neon-purple/5 border border-neon-purple/20">
						<p class="text-xs sm:text-sm font-mono text-gray-400">
							<span class="text-neon-purple">#</span> Your information is secure and will only be used to respond to your message.
						</p>
					</div>

					<!-- Submit Button -->
					<div class="pt-4 flex gap-3">
						<button 
							type="submit"
							class="group relative flex-1 px-6 py-3 font-mono font-bold text-sm uppercase tracking-widest border-2 border-neon-purple text-neon-purple hover:text-cyber-darker overflow-hidden transition-all duration-300 rounded-lg"
						>
							<span class="relative z-10">TRANSMIT MESSAGE</span>
							<div class="absolute inset-0 bg-neon-purple transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left -z-0 rounded-lg"></div>
						</button>

						<button 
							type="reset"
							class="px-6 py-3 font-mono font-bold text-sm uppercase tracking-widest border-2 border-gray-500 text-gray-400 hover:border-gray-300 hover:text-gray-300 transition-all duration-300 rounded-lg"
						>
							CLEAR
						</button>
					</div>

					<!-- Success Message (hidden by default) -->
					<div id="success-message" class="hidden p-4 rounded-lg bg-neon-cyan/10 border border-neon-cyan/50">
						<p class="font-mono text-sm text-neon-cyan">
							<span class="text-green-400">✓</span> Message transmitted successfully! I'll get back to you soon.
						</p>
					</div>

					<!-- Error Message (hidden by default) -->
					<div id="error-message" class="hidden p-4 rounded-lg bg-red-500/10 border border-red-500/50">
						<p class="font-mono text-sm text-red-400">
							<span class="text-red-500">✗</span> Error transmitting message. Please try again.
						</p>
					</div>
				</form>

				<!-- Terminal Line 2 -->
				<div class="mt-8 pt-6 border-t border-neon-purple/20 font-mono text-xs sm:text-sm text-gray-400">
					<span class="text-neon-purple">$</span> <span class="text-white">awaiting_response...</span>
				</div>

				<!-- Alternative Contact Methods -->
				<div class="mt-8 pt-6 border-t border-neon-purple/20 space-y-3">
					<p class="font-mono text-xs text-neon-purple mb-4">// ALTERNATIVE CONTACT METHODS</p>

					<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
						<a 
							href="mailto:Alvin.Oba67@gmail.com"
							class="group p-3 rounded-lg border border-neon-cyan/30 bg-cyber-black/50 hover:border-neon-cyan/80 hover:bg-neon-cyan/10 transition-all duration-300 text-center"
						>
							<div class="font-mono text-xs text-neon-cyan font-bold mb-1">EMAIL</div>
							<div class="text-xs text-gray-300 group-hover:text-white transition-colors">Alvin.Oba67@gmail.com</div>
						</a>

						<a 
							href="https://github.com/alvinoba"
							target="_blank"
							rel="noopener noreferrer"
							class="group p-3 rounded-lg border border-neon-magenta/30 bg-cyber-black/50 hover:border-neon-magenta/80 hover:bg-neon-magenta/10 transition-all duration-300 text-center"
						>
							<div class="font-mono text-xs text-neon-magenta font-bold mb-1">GITHUB</div>
							<div class="text-xs text-gray-300 group-hover:text-white transition-colors">@alvinoba0607</div>
						</a>

						<a 
							href="http://www.linkedin.com/in/alvin-oba-9bb097251"
							target="_blank"
							rel="noopener noreferrer"
							class="group p-3 rounded-lg border border-neon-purple/30 bg-cyber-black/50 hover:border-neon-purple/80 hover:bg-neon-purple/10 transition-all duration-300 text-center"
						>
							<div class="font-mono text-xs text-neon-purple font-bold mb-1">LINKEDIN</div>
							<div class="text-xs text-gray-300 group-hover:text-white transition-colors">/in/alvin-oba</div>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Decorative elements -->
	<div class="absolute top-1/4 right-0 w-96 h-96 bg-neon-purple/10 rounded-full blur-3xl pointer-events-none opacity-20"></div>
</section>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const successMessage = document.getElementById('success-message');
	const errorMessage = document.getElementById('error-message');

	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();

			// Hide previous messages
			if (successMessage) successMessage.classList.add('hidden');
			if (errorMessage) errorMessage.classList.add('hidden');

			const formData = new FormData(form);
			const data = Object.fromEntries(formData);

			try {
				// Validate form
				if (!data.name || !data.email || !data.subject || !data.message) {
					throw new Error('All fields are required');
				}

				if ((data.message as string).length < 10) {
					throw new Error('Message must be at least 10 characters');
				}

				// Simulate form submission (replace with actual API call)
				await new Promise(resolve => setTimeout(resolve, 1000));

				// Show success message
				if (successMessage) {
					successMessage.classList.remove('hidden');
					form.reset();
					setTimeout(() => {
						successMessage?.classList.add('hidden');
					}, 5000);
				}
			} catch (error) {
				// Show error message
				if (errorMessage) {
					errorMessage.classList.remove('hidden');
					errorMessage.textContent = `✗ ${(error as Error).message}`;
				}
			}
		});
	}
</script>

<style scoped>
	/* Custom input styling */
	input::placeholder,
	textarea::placeholder {
		@apply text-gray-600;
	}

	input:focus,
	textarea:focus {
		@apply bg-cyber-black/80;
	}

	/* Textarea resize handle */
	textarea {
		resize: vertical;
	}

	/* Animation for success message */
	@keyframes slideDown {
		from {
			opacity: 0;
			transform: translateY(-10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	#success-message:not(.hidden),
	#error-message:not(.hidden) {
		animation: slideDown 0.3s ease-out;
	}
</style>
