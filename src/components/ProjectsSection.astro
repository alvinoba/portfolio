---
// ProjectsSection.astro - Showcase of Projects
import ProjectCard from './ProjectCard.astro';

// Sample project data - replace with your actual projects
const projects = [
/*	
	{
		title: 'AI Chat Interface',
		description: 'Real-time chat application with AI integration, built with React and WebSocket. Features message persistence, user authentication, and responsive design.',
		tags: ['React', 'TypeScript', 'WebSocket', 'Node.js'],
		liveUrl: 'https://example.com/chat',
		githubUrl: 'https://github.com/example/chat',
		image: 'https://images.unsplash.com/photo-1677442d019cecf8cfd563fb0e41999b5b63e6a9?w=500&h=300&fit=crop',
	},
	{
		title: 'Design System UI Kit',
		description: 'Comprehensive component library with 50+ reusable components. Built with Storybook, Tailwind CSS, and published to npm.',
		tags: ['React', 'Tailwind CSS', 'Storybook', 'npm'],
		liveUrl: 'https://example.com/design-system',
		githubUrl: 'https://github.com/example/design-system',
		image: 'https://images.unsplash.com/photo-1561070791-2526d30994b5?w=500&h=300&fit=crop',
	},
	{
		title: 'Data Visualization Dashboard',
		description: 'Interactive analytics dashboard with real-time charts and filters. Visualizes complex datasets using D3.js and React.',
		tags: ['React', 'D3.js', 'Python', 'PostgreSQL'],
		liveUrl: 'https://example.com/dashboard',
		githubUrl: 'https://github.com/example/dashboard',
		image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=500&h=300&fit=crop',
	},
*/
];
---

<section id="featured-work" class="w-full px-4 sm:px-6 lg:px-8 py-20 sm:py-32 relative">
	<!-- Section Header -->
	<div class="max-w-6xl mx-auto mb-12 sm:mb-16">
		<div class="flex items-center gap-3 mb-4">
			<div class="w-3 h-3 rounded-full bg-neon-cyan animate-pulse" style="box-shadow: 0 0 10px rgba(0, 243, 255, 0.8);"></div>
			<span class="font-mono text-xs sm:text-sm text-neon-cyan tracking-wider">PROJECT PORTFOLIO</span>
		</div>

		<div class="mb-6">
			<h2 class="text-4xl sm:text-5xl lg:text-6xl font-mono font-bold mb-4">
				<span class="text-neon-cyan">[ </span>
				<span class="text-white">FEATURED WORK</span>
				<span class="text-neon-cyan"> ]</span>
			</h2>
			<div class="h-px w-32 sm:w-48 bg-gradient-to-r from-neon-cyan to-transparent"></div>
		</div>

		<p class="text-gray-300 text-base sm:text-lg max-w-2xl">
			Explore my most impactful projects showcasing expertise in full-stack, multiplatform development, design systems, artificial intelligence and innovative technologies. Each project represents a unique challenge solved through creative problem-solving and technical excellence.
		</p>
	</div>

	<!-- Projects Grid -->
	<div class="max-w-6xl mx-auto">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
			{projects.map((project) => (
				<ProjectCard {...project} />
			))}
		</div>
	</div>

	<!-- View More CTA -->
	<div class="flex justify-center mt-12 sm:mt-16">
		<a 
			href="https://github.com/alvinoba"
			target="_blank"
			rel="noopener noreferrer"
			class="group relative px-8 sm:px-12 py-4 font-mono font-bold text-sm sm:text-base uppercase tracking-widest border-2 border-neon-purple text-neon-purple hover:text-cyber-darker overflow-hidden transition-all duration-300"
		>
			<span class="relative z-10">EXPLORE MORE PROJECTS</span>
			<div class="absolute inset-0 bg-neon-purple transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left -z-0"></div>
		</a>
	</div>

	<!-- Decorative elements -->
	<div class="absolute top-20 right-10 w-72 h-72 bg-neon-purple/10 rounded-full blur-3xl pointer-events-none opacity-20"></div>
</section>

<style scoped>
	/* Grid animation on page load */
	@keyframes grid-fade {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	:global(.grid > *) {
		animation: grid-fade 0.6s ease-out forwards;
	}

	:global(.grid > *:nth-child(1)) {
		animation-delay: 0.1s;
	}

	:global(.grid > *:nth-child(2)) {
		animation-delay: 0.2s;
	}

	:global(.grid > *:nth-child(3)) {
		animation-delay: 0.3s;
	}

	:global(.grid > *:nth-child(4)) {
		animation-delay: 0.4s;
	}

	:global(.grid > *:nth-child(5)) {
		animation-delay: 0.5s;
	}

	:global(.grid > *:nth-child(6)) {
		animation-delay: 0.6s;
	}
</style>