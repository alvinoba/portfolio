---
// Hero Component - Futuristic Cyberpunk Section
---

<section class="min-h-screen w-full flex items-center justify-center px-4 sm:px-6 lg:px-8 py-20 sm:py-32 relative overflow-hidden">
	<!-- Animated background elements -->
	<div class="absolute inset-0 overflow-hidden pointer-events-none">
		<!-- Animated corner brackets -->
		<div class="absolute top-10 left-10 w-12 h-12 border-t-2 border-l-2 border-neon-cyan opacity-30 animate-pulse"></div>
		<div class="absolute top-10 right-10 w-12 h-12 border-t-2 border-r-2 border-neon-magenta opacity-30 animate-pulse" style="animation-delay: 1s;"></div>
		<div class="absolute bottom-10 left-10 w-12 h-12 border-b-2 border-l-2 border-neon-purple opacity-30 animate-pulse" style="animation-delay: 2s;"></div>
		<div class="absolute bottom-10 right-10 w-12 h-12 border-b-2 border-r-2 border-neon-cyan opacity-30 animate-pulse" style="animation-delay: 3s;"></div>

		<!-- Floating glitch lines -->
		<div class="absolute top-1/4 left-0 w-1/3 h-px bg-gradient-to-r from-neon-cyan to-transparent opacity-20"></div>
		<div class="absolute bottom-1/3 right-0 w-1/4 h-px bg-gradient-to-l from-neon-magenta to-transparent opacity-20"></div>
	</div>

	<!-- Main content container -->
	<div class="relative z-10 max-w-4xl w-full mx-auto">
		<!-- System status indicator -->
		<div class="flex items-center justify-center mb-8 sm:mb-12">
			<div class="flex items-center gap-3">
				<div class="w-3 h-3 rounded-full bg-neon-cyan animate-pulse" style="box-shadow: 0 0 10px rgba(0, 243, 255, 0.8);"></div>
				<span class="font-mono text-xs sm:text-sm text-neon-cyan tracking-wider">SYSTEM STATUS: ONLINE</span>
				<div class="w-3 h-3 rounded-full bg-neon-cyan animate-pulse" style="box-shadow: 0 0 10px rgba(0, 243, 255, 0.8); animation-delay: 0.5s;"></div>
			</div>
		</div>

		<!-- Main headline with glowing effect -->
		<div class="text-center mb-6 sm:mb-8">
			<h1 class="font-mono text-4xl sm:text-6xl lg:text-7xl font-bold mb-4 tracking-tight">
				<span class="text-neon-cyan">[ </span>
				<span class="text-white bg-clip-text bg-gradient-to-r from-neon-cyan via-white to-neon-magenta">
					WELCOME TO MY PORTFOLIO
				</span>
				<span class="text-neon-cyan"> ]</span>
			</h1>

			<!-- Animated line separator -->
			<div class="h-px w-32 sm:w-48 mx-auto bg-gradient-to-r from-transparent via-neon-cyan to-transparent mb-6"></div>

			<!-- Subtitle with secondary styling -->
			<p class="font-mono text-base sm:text-lg lg:text-xl text-neon-cyan mb-2">
				// INITIALIZING PERSONAL PORTFOLIO SYSTEM
			</p>
			<p class="text-lg sm:text-2xl lg:text-3xl text-gray-300 font-light tracking-wide">
				Student • Developer • Researcher
			</p>
		</div>

		<!-- CTA Buttons Container -->
		<div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center mt-10 sm:mt-14">
			<!-- Primary CTA: View Modules -->
			<button
				class="group relative px-8 sm:px-10 py-3 sm:py-4 font-mono font-bold text-sm sm:text-base uppercase tracking-widest
				border-2 border-neon-cyan text-neon-cyan
				hover:text-cyber-darker hover:bg-neon-cyan
				overflow-hidden transition-all duration-300 ease-out
				hover:shadow-[0_0_20px_rgba(0,243,255,0.8),_inset_0_0_20px_rgba(0,243,255,0.3)]"
				onclick="document.getElementById('featured-work').scrollIntoView({ behavior: 'smooth' })"
			>
				<span class="relative z-10">View Modules</span>
				<div class="absolute inset-0 bg-neon-cyan transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left -z-0"></div>
			</button>

			<!-- Secondary CTA: Initiate Contact -->
			<button
				onclick="document.getElementById('contact').scrollIntoView({ behavior: 'smooth' })"
				class="group relative px-8 sm:px-10 py-3 sm:py-4 font-mono font-bold text-sm sm:text-base uppercase tracking-widest
				border-2 border-neon-magenta text-neon-magenta
				hover:text-cyber-darker hover:bg-neon-magenta
				overflow-hidden transition-all duration-300 ease-out
				hover:shadow-[0_0_20px_rgba(255,0,127,0.8),_inset_0_0_20px_rgba(255,0,127,0.3)]"
			>
				<span class="relative z-10">Initiate Contact</span>
				<div class="absolute inset-0 bg-neon-magenta transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left -z-0"></div>
			</button>
		</div>

		<!-- HUD Terminal Box -->
		<div class="mt-12 sm:mt-16 lg:mt-20">
			<div class="glass border border-neon-cyan/30 p-6 sm:p-8 rounded-lg relative overflow-hidden group hover:border-neon-cyan/60 transition-all duration-300">
				<!-- Top left corner bracket -->
				<div class="absolute top-3 left-3 w-4 h-4 border-t-2 border-l-2 border-neon-cyan opacity-50"></div>
				<!-- Top right corner bracket -->
				<div class="absolute top-3 right-3 w-4 h-4 border-t-2 border-r-2 border-neon-cyan opacity-50"></div>
				<!-- Bottom left corner bracket -->
				<div class="absolute bottom-3 left-3 w-4 h-4 border-b-2 border-l-2 border-neon-cyan opacity-50"></div>
				<!-- Bottom right corner bracket -->
				<div class="absolute bottom-3 right-3 w-4 h-4 border-b-2 border-r-2 border-neon-cyan opacity-50"></div>

				<!-- Content -->
				<div class="relative z-10">
					<div class="font-mono text-xs sm:text-sm text-neon-cyan mb-4 flex items-center gap-2">
						<span class="inline-block w-2 h-2 bg-neon-cyan rounded-full"></span>
						HUD_SYSTEM.READY
					</div>

					<h2 class="text-2xl sm:text-3xl font-bold font-mono text-white mb-3">
						[ SYSTEM INITIALIZATION SEQUENCE ]
					</h2>

					<p class="text-gray-300 text-sm sm:text-base leading-relaxed mb-4">
						Welcome to my digital portfolio. This interface showcases my work in full-stack development, design systems, and innovative web technologies. Navigate through the modules below to explore my projects, skills, and professional journey.
					</p>

					<!-- Status indicators -->
					<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-6 pt-6 border-t border-neon-cyan/20">
						<div class="text-center">
							<div class="text-2xl sm:text-3xl font-bold text-neon-cyan">3+</div>
							<div class="text-xs text-gray-400 font-mono mt-1">PROJECTS.COMPLETED</div>
						</div>
						<div class="text-center">
							<div class="text-2xl sm:text-3xl font-bold text-neon-magenta">5+</div>
							<div class="text-xs text-gray-400 font-mono mt-1">SKILLS.PROFICIENT</div>
						</div>
						<div class="text-center">
							<div class="text-2xl sm:text-3xl font-bold text-neon-purple">100%</div>
							<div class="text-xs text-gray-400 font-mono mt-1">COMMITMENT</div>
						</div>
					</div>
				</div>

				<!-- Animated glow on hover -->
				<div class="absolute inset-0 opacity-0 group-hover:opacity-20 transition-opacity duration-300 rounded-lg" style="background: radial-gradient(circle at center, rgba(0, 243, 255, 0.5) 0%, transparent 70%);"></div>
			</div>
		</div>

		<!-- Scroll indicator -->
		
	</div>
</section>

<style scoped>
	/* Additional scoped animations and styles */

	@keyframes float {
		0%, 100% {
			transform: translateY(0px);
		}
		50% {
			transform: translateY(-10px);
		}
	}

	@keyframes glow-text {
		0%, 100% {
			text-shadow: 0 0 10px rgba(0, 243, 255, 0.5), 0 0 20px rgba(0, 243, 255, 0.3);
		}
		50% {
			text-shadow: 0 0 20px rgba(0, 243, 255, 0.8), 0 0 40px rgba(0, 243, 255, 0.5), 0 0 60px rgba(255, 0, 127, 0.3);
		}
	}

	/* HUD box shadow effect */
	.glass {
		box-shadow: 0 0 30px rgba(0, 243, 255, 0.2);
	}

	.glass:hover {
		box-shadow: 0 0 40px rgba(0, 243, 255, 0.4);
	}

	/* CTA button active state */
	button:active {
		transform: scale(0.98);
	}

	/* Responsive adjustments */
	@media (max-width: 640px) {
		section {
			min-height: auto;
			padding-top: 60px;
			padding-bottom: 100px;
		}
	}
</style>
