---
// ProjectCard.astro - Reusable Project Card with Glassmorphism
interface Props {
	title: string;
	description: string;
	tags: string[];
	liveUrl?: string;
	githubUrl?: string;
	image?: string;
}

const { title, description, tags, liveUrl, githubUrl, image } = Astro.props;
---

<div class="group relative h-full rounded-lg border border-neon-cyan/30 bg-cyber-black/40 backdrop-blur-md overflow-hidden transition-all duration-300 hover:border-neon-cyan/80 hover:shadow-[0_0_30px_rgba(0,243,255,0.4)]">
	<!-- Corner brackets on hover -->
	<div class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-neon-cyan opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
	<div class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-neon-cyan opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
	<div class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-neon-cyan opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
	<div class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-neon-cyan opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

	<!-- Background glow on hover -->
	<div class="absolute inset-0 opacity-0 group-hover:opacity-20 transition-opacity duration-300 bg-gradient-to-br from-neon-cyan to-neon-magenta pointer-events-none"></div>

	<!-- Project Image -->
	{image && (
		<div class="relative h-40 sm:h-48 overflow-hidden bg-gradient-to-b from-neon-cyan/10 to-neon-magenta/10">
			<img 
				src={image} 
				alt={title}
				class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
			/>
			<div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-all duration-300"></div>
		</div>
	)}

	<!-- Content -->
	<div class="relative z-10 p-5 sm:p-6">
		<!-- Project Title -->
		<h3 class="text-lg sm:text-xl font-mono font-bold text-neon-cyan mb-2 group-hover:text-white transition-colors duration-300">
			[ {title} ]
		</h3>

		<!-- Description -->
		<p class="text-sm sm:text-base text-gray-300 mb-4 line-clamp-3 group-hover:line-clamp-none transition-all duration-300">
			{description}
		</p>

		<!-- Tech Stack Tags -->
		<div class="flex flex-wrap gap-2 mb-4">
			{tags.map((tag) => (
				<span class="inline-block px-3 py-1 text-xs font-mono font-bold bg-neon-cyan/10 border border-neon-cyan/50 text-neon-cyan rounded-full hover:bg-neon-cyan/20 hover:border-neon-cyan transition-all duration-200">
					{tag}
				</span>
			))}
		</div>

		<!-- Links -->
		<div class="flex gap-3 pt-4 border-t border-neon-cyan/20">
			{liveUrl && (
				<a 
					href={liveUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="flex-1 px-4 py-2 text-center text-xs sm:text-sm font-mono font-bold text-neon-cyan border border-neon-cyan/50 rounded hover:bg-neon-cyan hover:text-cyber-darker transition-all duration-300"
				>
					LIVE DEMO
				</a>
			)}
			{githubUrl && (
				<a 
					href={githubUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="flex-1 px-4 py-2 text-center text-xs sm:text-sm font-mono font-bold text-neon-magenta border border-neon-magenta/50 rounded hover:bg-neon-magenta hover:text-cyber-darker transition-all duration-300"
				>
					GITHUB
				</a>
			)}
		</div>
	</div>
</div>

<style scoped>
	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.line-clamp-none {
		display: block;
		-webkit-line-clamp: unset;
	}
</style>
